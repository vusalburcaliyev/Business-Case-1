{
  "name": "BankCampaign",
  "compatibilityLevel": 1600,
  "model": {
    "name": "Model",
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Campaign\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "tables": [
      {
        "name": "Campaign",
        "columns": [
          {
            "name": "Channel",
            "dataType": "string",
            "sourceColumn": "Channel",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "sortByColumn": "Month order"
          },
          {
            "name": "Month order",
            "dataType": "int64",
            "sourceColumn": "Month order",
            "summarizeBy": "none"
          },
          {
            "name": "Contact band",
            "dataType": "string",
            "sourceColumn": "Contact band",
            "summarizeBy": "none",
            "sortByColumn": "Band order"
          },
          {
            "name": "Band order",
            "dataType": "int64",
            "sourceColumn": "Band order",
            "summarizeBy": "none"
          },
          {
            "name": "Prior contact",
            "dataType": "string",
            "sourceColumn": "Prior contact",
            "summarizeBy": "none"
          },
          {
            "name": "Previous outcome",
            "dataType": "string",
            "sourceColumn": "Previous outcome",
            "summarizeBy": "none"
          },
          {
            "name": "Records",
            "dataType": "int64",
            "sourceColumn": "Records",
            "summarizeBy": "none"
          },
          {
            "name": "Subscriptions",
            "dataType": "int64",
            "sourceColumn": "Subscriptions",
            "summarizeBy": "none"
          },
          {
            "name": "Contacts",
            "dataType": "int64",
            "sourceColumn": "Contacts",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Campaign records",
            "expression": "SUM('Campaign'[Records])",
            "formatString": "#,0"
          },
          {
            "name": "Total subscriptions",
            "expression": "SUM('Campaign'[Subscriptions])",
            "formatString": "#,0"
          },
          {
            "name": "Total contacts",
            "expression": "SUM('Campaign'[Contacts])",
            "formatString": "#,0"
          },
          {
            "name": "Subscription rate",
            "expression": "DIVIDE([Total subscriptions], [Campaign records])",
            "formatString": "0.00%"
          },
          {
            "name": "Average contacts",
            "expression": "DIVIDE([Total contacts], [Campaign records])",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Campaign",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Snapshot = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Snapshot, type table [#\"Channel\" = nullable text, #\"Month\" = nullable text, #\"Month order\" = nullable number, #\"Contact band\" = nullable text, #\"Band order\" = nullable number, #\"Prior contact\" = nullable text, #\"Previous outcome\" = nullable text, #\"Records\" = nullable number, #\"Subscriptions\" = nullable number, #\"Contacts\" = nullable number]),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"Month order\", Int64.Type}, {\"Band order\", Int64.Type}, {\"Records\", Int64.Type}, {\"Subscriptions\", Int64.Type}, {\"Contacts\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "relationships": []
  }
}
